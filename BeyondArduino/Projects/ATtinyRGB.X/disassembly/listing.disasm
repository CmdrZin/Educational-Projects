21:            /* Return the total number of milliseconds since the project started. */
22:            uint32_t millis(void)
23:            {
24:            	uint32_t temp;			// make a holder for the counter.
25:            
26:            	cli();				// Turn OFF interrupts to avoid corruption
0123  94F8     CLI
27:            						// during a multi-byte read.
28:            	temp = totalMilliseconds;	// get a copy while interrupts are disabled.
0124  9160     LDS R22, 0x3808
0126  9170     LDS R23, 0x3809
0128  9180     LDS R24, 0x380A
012A  9190     LDS R25, 0x380B
29:            	sei();				// Turn interrupts back ON.
012C  9478     SEI
30:            
31:            	return temp;			// return a 'clean' copy of the counter.
32:            }
012D  9508     RET
012E  01EC     MOVW R28, R24
33:            
34:            /* *** TCA Configuration as NORMAL counter with interrupt for 1ms OVF *** */
35:            void init_systime(void)
36:            {
37:            	TCA0_SINGLE_PER = 0x0D04;       // 3,333 - 1 since the counter starts at 0.
38:               	/* enable overflow interrupt */
39:            	TCA0.SINGLE.INTCTRL = TCA_SINGLE_OVF_bm;
40:            	/* set Normal mode */
41:            	TCA0.SINGLE.CTRLB = TCA_SINGLE_WGMODE_NORMAL_gc;
42:            	TCA0.SINGLE.CTRLA = TCA_SINGLE_CLKSEL_DIV1_gc  /* set CLK_PER/64) */
43:            					| TCA_SINGLE_ENABLE_bm; 	/* start timer */
44:            
45:            }
