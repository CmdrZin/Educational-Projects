                                                  7:      * WS2812B
                                                  8:      * 0: H:0.40us L:0.85us
                                                  9:      * 1: H:0.80us L:0.45us
                                                  10:     * SK6812
                                                  11:     * 0: H:0.30us L:0.95us
                                                  12:     * 1: H:0.60us L:0.65us
                                                  13:     * SKC6812RV
                                                  14:     * 0: H:0.30us L:0.95us
                                                  15:     * 1: H:0.80us L:0.45us
                                                  16:     *
                                                  17:     * Target: ATtiny AVR Series-1
                                                  18:     * Uses 20 MHz (0.050 us) CPU clock
                                                  19:     *
                                                  20:     * C_ASM_ICD
                                                  21:     * Can use r18:27, r30:31 in ASM without saving
                                                  22:     * X:r27,r26	Y:r29,r28	Z:r31,30	r1=0 always
                                                  23:     */ 
                                                  24:    #include <xc.h>
                                                  25:    //#include <avr/io.h>
                                                  26:        
                                                  27:    #define DOUT_PORT 0x0404	// PORTA.OUT (0x0404) SFR address. MUST MATCH DEVICE PORT! .. ATtiny412 8SIOC
                                                  28:    #define DOUT_PIN  3		// MUST MATCH DEVICE PIN! .. ATtiny412 8SIOC
                                                  29:    
                                                  30:    .extern ledColor
                                                  31:        
                                                  32:    /*
                                                  33:     * sendLED(RGB_COLOR_t out)
                                                  34:     *
                                                  35:     * r25:r24 = out
                                                  36:     * table has 3 bytes per entry. (see rgb.h GRB_t)
                                                  37:     * bytes: ledColor[out].green, ledColor[out].red, ledColor[out].blue
                                                  38:     *
                                                  39:     * For multiple LEDs, must be called again withing 50us after return.
                                                  40:     */
                                                  41:        .section	.text
                                                  42:        .global	sendLED
                                                  43:    sendLED:
                                                  44:        ; multiply index by 3
0077  2F28     MOV R18, R24                       45:        mov	    r18, r24
0078  0F88     ADD R24, R24                       46:        add	    r24, r24			; double
0079  0F82     ADD R24, R18                       47:        add	    r24, r18			; x3
                                                  48:        ; Z = table
007A  E0F0     LDI R31, 0x00                      49:        ldi	    ZH, hi8(ledColor)
007B  EDEC     LDI R30, 0xDC                      50:        ldi	    ZL, lo8(ledColor)
                                                  51:        ; add index
007C  0FE8     ADD R30, R24                       52:        add	    ZL, r24
007D  1DF1     ADC R31, R1                        53:        adc	    ZH, r1			; r1 always 0
                                                  54:        ; get GREEN color code
007E  9185     LPM R24, Z+                        55:        lpm	    r24, Z+			; (3)
007F  D005     RCALL 0x85                         56:        rcall sendByte			; (4)
                                                  57:        ; get RED color code
0080  9185     LPM R24, Z+                        58:        lpm	    r24, Z+			; (3)
0081  D003     RCALL 0x85                         59:        rcall sendByte			; (4)
                                                  60:        ; get BLUE color code
0082  9184     LPM R24, Z                         61:        lpm		r24, Z			; (3)
0083  D001     RCALL 0x85                         62:        rcall sendByte			; (4)
                                                  63:        ;
0084  9508     RET                                64:        ret    
                                                  65:    
                                                  66:    /*
                                                  67:     * Send byte to SKC6812RV using stated timing sequence.
                                                  68:     * WS2812B
                                                  69:     * 0: H:0.40us L:0.85us
                                                  70:     * 1: H:0.80us L:0.45us
                                                  71:     * SK6812
                                                  72:     * 0: H:0.30us L:0.95us
                                                  73:     * 1: H:0.60us L:0.65us
                                                  74:     * SKC6812RV
                                                  75:     * 0: H:0.30us L:0.95us
                                                  76:     * 1: H:0.80us L:0.45us
                                                  77:     *
                                                  78:     * ASSUMES a 50ns clock (20 MHz)
                                                  79:     *     
                                                  80:     * r24 = byte
                                                  81:     *				; clks		    Accumlative
                                                  82:     *				; (n)			m
                                                  83:     */
                                                  84:    sendByte:
                                                  85:        ; DISABLE INTERRUPTS. This code is time critical.
0085  94F8     CLI                                86:        cli
                                                  87:        ;
0086  E098     LDI R25, 0x08                      88:        ldi	    r25, 8		; (1) load bit count
                                                  89:        ;
                                                  90:    wuLoop01:
                                                  91:        ; Test bit
0087  1F88     ADC R24, R24                       92:        rol	    r24		; (1) move test bit into CY
0088  F0E8     BRCS 0xA6                          93:        brcs    wuSkip01	; (f.1) (t.2) go to Output a 1.
                                                  94:        ;
                                                  95:        ; Output a 0 [0.30us]. H for 6 cycles (0.30us)
                                                  96:    wuLoop02:
                                                  97:    ;    sbi	    _SFR_IO_ADDR(PORTA), 3   ; SBI does not work with new AVRs
0089  E0A4     LDI R26, 0x04                      98:        LDI XL, lo8(DOUT_PORT)	; lsb of addr   (1)
008A  E0B4     LDI R27, 0x04                      99:        LDI XH, hi8(DOUT_PORT)	; msb of addr   (1)
008B  91AC     LD R26, X                          100:       LD	r26, X			; read PORT	(2)
008C  60A8     ORI R26, 0x08                      101:       ORI r26, (1<<DOUT_PIN)	; set bit3	(1)
008D  93AC     ST X, R26                          102:       ST X, r26			; update port   (1)	1
                                                  103:   ;
008E  0000     NOP                                104:       nop				; (1)			2
008F  0000     NOP                                105:       nop				; (1)			3
0090  0000     NOP                                106:       nop				; (1)			4
0091  0000     NOP                                107:       nop				; (1)			5
