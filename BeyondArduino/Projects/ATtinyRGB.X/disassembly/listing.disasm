011B  17C0     CP R28, R16
011C  07D1     CPC R29, R17
011D  F7D9     BRNE 0x119
35:                    sendLED(outPattern[i]);         // call ASM function
0119  9189     LD R24, Y+
011A  DF5C     RCALL sendLED
36:                }
37:            }
011E  91DF     POP R29
011F  91CF     POP R28
0120  911F     POP R17
0121  910F     POP R16
0122  9508     RET
