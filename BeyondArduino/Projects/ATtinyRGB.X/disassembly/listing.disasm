                                                  111:   ;    cbi	    DOUT_PORT, 3   ; (2) Set L for 19 cycles (0.95us) and do next check
                                                  112:   ; reuse X to access PORT
0093  91AC     LD R26, X                          113:       LD	r26, X			; read PORT	(2)
0094  7FA7     ANDI R26, 0xF7                     114:       ANDI r26, ~(1<<DOUT_PIN)	; clear bit3	(1)
0095  93AC     ST X, R26                          115:       ST X, r26			; update port   (1)	1
                                                  116:   ; 
0096  959A     DEC R25                            117:       dec	    r25			; (1) Dec bit count.			3
