00E2  93A0     STS 0x380A, R26
00E4  93B0     STS 0x380B, R27
18:                TCA0.SINGLE.INTFLAGS = TCA_SINGLE_OVF_bm;   // clear the interrupt flag
00E6  E081     LDI R24, 0x01
00E7  9380     STS 0xA0B, R24
19:            }
00E9  91BF     POP R27
00EA  91AF     POP R26
